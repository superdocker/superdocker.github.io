---
const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};
---

<header class="sticky top-0 z-50 border-b border-zinc-200 bg-white/90 backdrop-blur-sm">
  <nav class="max-w-3xl mx-auto px-6 h-11 flex items-center justify-between">
    <a href="/" class="text-sm font-semibold text-zinc-900 hover:text-zinc-600 transition-colors">
      Janghwan Lee
    </a>
    <ul class="flex items-center gap-6">
      <li>
        <a
          href="/"
          class={`text-sm transition-colors ${isActive('/') ? 'text-zinc-900 font-medium' : 'text-zinc-500 hover:text-zinc-900'}`}
        >
          About
        </a>
      </li>
      <li>
        <a
          href="/publications"
          class={`text-sm transition-colors ${isActive('/publications') ? 'text-zinc-900 font-medium' : 'text-zinc-500 hover:text-zinc-900'}`}
        >
          Publications
        </a>
      </li>
      <li>
        <a
          href="/pdf/cv_janghwan.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-zinc-500 hover:text-zinc-900 transition-colors"
        >
          CV
        </a>
      </li>
    </ul>
  </nav>
</header>
